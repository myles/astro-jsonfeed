{
  "name": "astro-jsonfeed",
  "version": "1.0.2",
  "description": "Generate a JSON Feed for your Astro site.",
  "keywords": [
    "astro",
    "jsonfeed"
  ],
  "homepage": "https://github.com/myles/astro-jsonfeed#readme",
  "bugs": {
    "url": "https://github.com/myles/astro-jsonfeed/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myles/astro-jsonfeed.git"
  },
  "license": "MIT",
  "author": "Myles Braithwaite",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "prettier": "prettier . -c",
    "prettier:write": "prettier . --write"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "astro": "^7.0.0",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0"
  }
}
